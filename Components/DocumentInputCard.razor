@using Microsoft.AspNetCore.Components.Forms

<div class="card doc-card h-100">
    <div class="card-body d-flex flex-column gap-3">
        <div>
            <div class="d-flex align-items-center justify-content-between gap-2">
                <h3 class="h6 mb-0">@Title</h3>
                @if (IsOptional)
                {
                    <span class="badge text-bg-secondary">Optional</span>
                }
            </div>
            <div class="small text-muted mt-1">
                @if (string.IsNullOrWhiteSpace(Document.FileName))
                {
                    <span>No file uploaded</span>
                }
                else
                {
                    <span>@Document.FileName</span>
                }
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 align-items-center">
            <InputFile @key="InputVersion" OnChange="HandleFileSelected" accept=".txt,.md,.pdf" class="form-control file-input" />
            <button class="btn btn-outline-secondary" type="button" @onclick="ClearRequested" disabled="@IsEmpty">Clear</button>
        </div>

        @if (Document.Warnings.Count > 0)
        {
            <div class="alert alert-warning py-2 mb-0">
                @foreach (var warning in Document.Warnings)
                {
                    <div>@warning</div>
                }
            </div>
        }

        <div class="flex-grow-1">
            <label class="form-label small text-muted" for="@TextAreaId">Extracted or pasted text</label>
            <textarea id="@TextAreaId"
                      class="form-control document-textarea"
                      @bind="Document.ExtractedText"
                      @bind:event="oninput"
                      placeholder="Paste text here if upload is unavailable or extraction is incomplete."></textarea>
        </div>

        <div class="small text-muted">@Document.CharacterCount.ToString("N0") characters</div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public bool IsOptional { get; set; }

    [Parameter, EditorRequired]
    public ProcessedDocument Document { get; set; } = new();

    [Parameter]
    public int InputVersion { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<InputFileChangeEventArgs> FileSelected { get; set; }

    [Parameter, EditorRequired]
    public EventCallback ClearRequested { get; set; }

    private string TextAreaId => $"{Title.Replace(' ', '-').ToLowerInvariant()}-text";

    private bool IsEmpty => string.IsNullOrWhiteSpace(Document.FileName) && string.IsNullOrWhiteSpace(Document.ExtractedText);

    private Task HandleFileSelected(InputFileChangeEventArgs args) => FileSelected.InvokeAsync(args);
}
