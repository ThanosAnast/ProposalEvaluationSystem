@page "/"
@page "/evaluation"
@rendermode InteractiveServer
@implements IDisposable
@using System.Diagnostics

@inject IDocumentTextExtractor DocumentTextExtractor
@inject IPromptTemplateService PromptTemplateService
@inject IPromptBuilder PromptBuilder
@inject IEvaluationProfileService EvaluationProfileService
@inject IScoreCalculator ScoreCalculator
@inject IEvaluationRunner EvaluationRunner
@inject IEsrComparisonService EsrComparisonService
@inject IExperimentRunFactory ExperimentRunFactory
@inject IExperimentRepository ExperimentRepository
@inject EvaluationWorkflowState WorkflowState
@inject Microsoft.Extensions.Options.IOptions<OpenAiOptions> OpenAiConfiguration
@inject Microsoft.Extensions.Options.IOptions<ExperimentsOptions> ExperimentConfiguration

<PageTitle>Proposal Evaluation</PageTitle>

<div class="workspace">
    <div class="page-heading">
        <div>
            <h1>Technical Proposal Evaluation</h1>
            <p class="text-muted mb-0">Independent Horizon evaluation followed by an optional, explicitly separate ESR comparison.</p>
        </div>
        <a class="btn btn-outline-primary" href="experiment-history">Experiment History</a>
    </div>

    @if (!OpenAiConfiguration.Value.IsConfigured)
    {
        <div class="alert alert-warning">
            OpenAI is not configured. Set user secret <code>OpenAI:ApiKey</code> or environment variable <code>OPENAI_API_KEY</code> before running an evaluation or comparison.
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert alert-success">@statusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <section class="card section-card">
        <div class="card-body">
            <div class="section-heading">
                <h2>Experiment Identity and Evaluation Profile</h2>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="datasetId">Dataset ID <span class="text-danger">*</span></label>
                    <input id="datasetId"
                           class="form-control"
                           @bind="datasetId"
                           @bind:event="oninput"
                           placeholder="e.g. horizon-dataset-001" />
                    <div class="form-text">Letters, numbers, periods, underscores, and hyphens only.</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="evaluationProfile">Evaluation Profile</label>
                    <select id="evaluationProfile" class="form-select" value="@selectedProfileId" @onchange="HandleProfileChanged">
                        @foreach (var profile in enabledProfiles)
                        {
                            <option value="@profile.Id">@profile.DisplayName</option>
                        }
                    </select>
                    <div class="form-text">The active prompt is selected automatically by the profile.</div>
                </div>
            </div>
        </div>
    </section>

    <section class="workspace-section">
        <div class="section-heading">
            <h2>Dataset Documents</h2>
        </div>
        <div class="row g-3">
            <div class="col-xl-4">
                <DocumentInputCard Title="Call / Topic Description"
                                   Document="callDocument"
                                   InputVersion="GetInputVersion(DocumentType.CallDescription)"
                                   FileSelected="@(args => HandleFileSelected(DocumentType.CallDescription, args))"
                                   TextChanged="@(text => HandleDocumentTextChanged(DocumentType.CallDescription, text))"
                                   ClearRequested="@(() => ClearDocument(DocumentType.CallDescription))" />
            </div>
            <div class="col-xl-4">
                <DocumentInputCard Title="Proposal"
                                   Document="proposalDocument"
                                   InputVersion="GetInputVersion(DocumentType.Proposal)"
                                   FileSelected="@(args => HandleFileSelected(DocumentType.Proposal, args))"
                                   TextChanged="@(text => HandleDocumentTextChanged(DocumentType.Proposal, text))"
                                   ClearRequested="@(() => ClearDocument(DocumentType.Proposal))" />
            </div>
            <div class="col-xl-4">
                <DocumentInputCard Title="ESR / Evaluation Summary Report"
                                   IsOptional="true"
                                   Document="esrDocument"
                                   InputVersion="GetInputVersion(DocumentType.EvaluationSummaryReport)"
                                   FileSelected="@(args => HandleFileSelected(DocumentType.EvaluationSummaryReport, args))"
                                   TextChanged="@(text => HandleDocumentTextChanged(DocumentType.EvaluationSummaryReport, text))"
                                   ClearRequested="@(() => ClearDocument(DocumentType.EvaluationSummaryReport))" />
            </div>
        </div>
    </section>

    <div class="row g-3 align-items-stretch">
        <div class="col-lg-6">
            <section class="card section-card h-100 independent-panel">
                <div class="card-body">
                    <div class="section-heading">
                        <h2>1. Independent Evaluation</h2>
                        <span class="text-muted small">@SelectedProfile.PromptTemplateFileName</span>
                    </div>
                    <p class="text-muted">Uses only the Call, Proposal, and selected evaluation profile. ESR content is excluded.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-outline-primary" type="button" @onclick="PreviewPromptAsync" disabled="@(!CanPreviewPrompt)">Preview Prompt</button>
                        <button class="btn btn-success" type="button" @onclick="RunIndependentEvaluationAsync" disabled="@(!CanRunIndependentEvaluation)">Run Independent Evaluation</button>
                        @if (isBusy)
                        {
                            <button class="btn btn-outline-danger" type="button" @onclick="CancelOperation">Cancel</button>
                        }
                    </div>
                </div>
            </section>
        </div>

        <div class="col-lg-6">
            <section class="card section-card h-100 comparison-panel">
                <div class="card-body">
                    <div class="section-heading">
                        <h2>2. ESR Comparison</h2>
                    </div>
                    <p class="text-muted">Confirm the official ESR scores. Numeric differences and threshold agreement are calculated by the application.</p>
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label" for="officialExcellence">Excellence</label>
                            <input id="officialExcellence" type="number" min="0" max="5" step="0.5" class="form-control"
                                   @bind="officialExcellence" @bind:event="oninput" @bind:after="ReferenceInputsChanged" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="officialImpact">Impact</label>
                            <input id="officialImpact" type="number" min="0" max="5" step="0.5" class="form-control"
                                   @bind="officialImpact" @bind:event="oninput" @bind:after="ReferenceInputsChanged" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="officialImplementation">Implementation</label>
                            <input id="officialImplementation" type="number" min="0" max="5" step="0.5" class="form-control"
                                   @bind="officialImplementation" @bind:event="oninput" @bind:after="ReferenceInputsChanged" />
                        </div>
                    </div>
                    <button class="btn btn-primary mt-3" type="button" @onclick="CompareWithEsrAsync" disabled="@(!CanCompareWithEsr)">Compare with ESR</button>
                </div>
            </section>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(WorkflowState.GeneratedPrompt))
    {
        <details class="details-panel">
            <summary>Independent prompt preview</summary>
            <textarea class="form-control prompt-preview mt-3" readonly>@WorkflowState.GeneratedPrompt</textarea>
        </details>
    }

    @if (WorkflowState.IndependentEvaluation is not null)
    {
        <EvaluationResultView Result="WorkflowState.IndependentEvaluation" />
    }

    @if (WorkflowState.EsrComparison is not null)
    {
        <EvaluationComparisonView Result="WorkflowState.EsrComparison" />
    }

    @if (WorkflowState.IndependentEvaluation is not null)
    {
        <section class="card section-card mt-3">
            <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <h2 class="h5 mb-1">Save Reproducible Experiment</h2>
                    <p class="text-muted mb-0">
                        @if (ExperimentConfiguration.Value.StoreSensitiveContent)
                        {
                            <span>Sensitive content storage is enabled under App_Data.</span>
                        }
                        else
                        {
                            <span>Only hashes, filenames, metadata, evaluation output, and comparison output will be stored.</span>
                        }
                    </p>
                </div>
                <button class="btn btn-outline-success" type="button" @onclick="SaveExperimentAsync" disabled="@(!CanSaveExperiment)">Save Experiment Run</button>
            </div>
        </section>
    }
</div>

@code {
    private ProcessedDocument callDocument = NewDocument(DocumentType.CallDescription);
    private ProcessedDocument proposalDocument = NewDocument(DocumentType.Proposal);
    private ProcessedDocument esrDocument = NewDocument(DocumentType.EvaluationSummaryReport);
    private IReadOnlyList<EvaluationProfile> enabledProfiles = [];
    private string selectedProfileId = EvaluationProfiles.HorizonEssentialId;
    private string datasetId = string.Empty;
    private decimal? officialExcellence;
    private decimal? officialImpact;
    private decimal? officialImplementation;
    private string? errorMessage;
    private string? statusMessage;
    private string? activePromptContent;
    private bool isBusy;
    private TimeSpan evaluationDuration;
    private CancellationTokenSource? operationCancellation;
    private readonly List<string> runErrors = [];
    private readonly Dictionary<DocumentType, int> inputVersions = new()
    {
        [DocumentType.CallDescription] = 0,
        [DocumentType.Proposal] = 0,
        [DocumentType.EvaluationSummaryReport] = 0
    };

    private EvaluationProfile SelectedProfile =>
        EvaluationProfileService.GetRequiredEnabledProfile(selectedProfileId);

    private bool CanPreviewPrompt => !isBusy &&
        !string.IsNullOrWhiteSpace(callDocument.ExtractedText) &&
        !string.IsNullOrWhiteSpace(proposalDocument.ExtractedText);

    private bool CanRunIndependentEvaluation => CanPreviewPrompt &&
        !string.IsNullOrWhiteSpace(datasetId) &&
        OpenAiConfiguration.Value.IsConfigured;

    private bool HasValidReferenceScores =>
        officialExcellence.HasValue && ScoreCalculator.IsValidScore(SelectedProfile, officialExcellence.Value) &&
        officialImpact.HasValue && ScoreCalculator.IsValidScore(SelectedProfile, officialImpact.Value) &&
        officialImplementation.HasValue && ScoreCalculator.IsValidScore(SelectedProfile, officialImplementation.Value);

    private bool CanCompareWithEsr => !isBusy &&
        OpenAiConfiguration.Value.IsConfigured &&
        WorkflowState.IndependentEvaluation is not null &&
        !string.IsNullOrWhiteSpace(esrDocument.ExtractedText) &&
        HasValidReferenceScores;

    private bool CanSaveExperiment => !isBusy &&
        WorkflowState.IndependentEvaluation is not null &&
        !string.IsNullOrWhiteSpace(datasetId);

    protected override void OnInitialized()
    {
        enabledProfiles = EvaluationProfileService.GetEnabledProfiles();
        if (enabledProfiles.Count == 0)
        {
            throw new InvalidOperationException("No enabled evaluation profiles are configured.");
        }

        selectedProfileId = enabledProfiles[0].Id;
    }

    private void HandleProfileChanged(ChangeEventArgs args)
    {
        var requestedId = args.Value?.ToString() ?? string.Empty;
        EvaluationProfileService.GetRequiredEnabledProfile(requestedId);
        if (string.Equals(selectedProfileId, requestedId, StringComparison.Ordinal))
        {
            return;
        }

        selectedProfileId = requestedId;
        InvalidateIndependentState();
        ClearMessages();
    }

    private async Task HandleFileSelected(DocumentType documentType, InputFileChangeEventArgs args)
    {
        ClearMessages();
        isBusy = true;

        try
        {
            var processedDocument = await DocumentTextExtractor.ExtractAsync(args.File, documentType);
            SetDocument(documentType, processedDocument);
            InvalidateForDocument(documentType);
            statusMessage = $"{args.File.Name} processed.";
        }
        catch (Exception exception)
        {
            errorMessage = $"The document could not be processed: {exception.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private void HandleDocumentTextChanged(DocumentType documentType, string text)
    {
        GetDocument(documentType).ExtractedText = text;
        InvalidateForDocument(documentType);
        ClearMessages();
    }

    private void ClearDocument(DocumentType documentType)
    {
        SetDocument(documentType, NewDocument(documentType));
        inputVersions[documentType]++;
        InvalidateForDocument(documentType);
        ClearMessages();
    }

    private async Task PreviewPromptAsync()
    {
        ClearMessages();
        try
        {
            var request = await BuildIndependentRequestAsync();
            if (WorkflowState.IndependentEvaluation is not null &&
                !string.Equals(WorkflowState.IndependentEvaluation.InputFingerprint, request.InputFingerprint, StringComparison.Ordinal))
            {
                InvalidateIndependentState();
            }

            WorkflowState.GeneratedPrompt = request.GeneratedPrompt;
            activePromptContent = request.PromptTemplateContent;
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
    }

    private async Task RunIndependentEvaluationAsync()
    {
        if (isBusy)
        {
            return;
        }

        ClearMessages();
        runErrors.Clear();
        isBusy = true;
        operationCancellation = new CancellationTokenSource();
        var stopwatch = Stopwatch.StartNew();

        try
        {
            FileExperimentRepository.ValidateDatasetId(datasetId);
            var request = await BuildIndependentRequestAsync(operationCancellation.Token);
            WorkflowState.InvalidateIndependentInputs();
            WorkflowState.GeneratedPrompt = request.GeneratedPrompt;
            activePromptContent = request.PromptTemplateContent;
            WorkflowState.IndependentEvaluation = await EvaluationRunner.EvaluateAsync(request, operationCancellation.Token);
            stopwatch.Stop();
            evaluationDuration = stopwatch.Elapsed;
            statusMessage = "Independent Horizon evaluation completed.";
        }
        catch (OperationCanceledException)
        {
            statusMessage = "The independent evaluation was cancelled.";
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            runErrors.Add(exception.Message);
        }
        finally
        {
            stopwatch.Stop();
            operationCancellation.Dispose();
            operationCancellation = null;
            isBusy = false;
        }
    }

    private async Task CompareWithEsrAsync()
    {
        if (isBusy || WorkflowState.IndependentEvaluation is null || !HasValidReferenceScores)
        {
            return;
        }

        ClearMessages();
        isBusy = true;
        operationCancellation = new CancellationTokenSource();

        try
        {
            if (!await EnsureEvaluationFingerprintIsCurrentAsync(operationCancellation.Token))
            {
                return;
            }

            var comparisonRequest = new EsrComparisonRequest
            {
                IndependentEvaluation = WorkflowState.IndependentEvaluation!,
                ReferenceEvaluation = CreateReferenceEvaluation(),
                Profile = SelectedProfile,
                EsrText = esrDocument.ExtractedText
            };

            WorkflowState.EsrComparison = await EsrComparisonService.CompareAsync(
                comparisonRequest,
                operationCancellation.Token);
            statusMessage = "ESR comparison completed without changing the independent evaluation.";
        }
        catch (OperationCanceledException)
        {
            statusMessage = "The ESR comparison was cancelled.";
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            runErrors.Add(exception.Message);
        }
        finally
        {
            operationCancellation.Dispose();
            operationCancellation = null;
            isBusy = false;
        }
    }

    private async Task SaveExperimentAsync()
    {
        if (isBusy || WorkflowState.IndependentEvaluation is null)
        {
            return;
        }

        ClearMessages();
        isBusy = true;
        try
        {
            datasetId = FileExperimentRepository.ValidateDatasetId(datasetId);
            if (!await EnsureEvaluationFingerprintIsCurrentAsync())
            {
                return;
            }

            var promptContent = activePromptContent
                ?? await PromptTemplateService.GetTemplateContentAsync(SelectedProfile.PromptTemplateFileName!);
            var warnings = callDocument.Warnings
                .Concat(proposalDocument.Warnings)
                .Concat(esrDocument.Warnings)
                .ToArray();
            var run = ExperimentRunFactory.Create(new ExperimentRunCreationRequest
            {
                DatasetId = datasetId,
                Profile = SelectedProfile,
                CallDocument = callDocument,
                ProposalDocument = proposalDocument,
                EsrDocument = string.IsNullOrWhiteSpace(esrDocument.ExtractedText) ? null : esrDocument,
                PromptContent = promptContent,
                GeneratedPrompt = WorkflowState.GeneratedPrompt ?? WorkflowState.IndependentEvaluation.GeneratedPrompt,
                IndependentEvaluation = WorkflowState.IndependentEvaluation,
                ComparisonResult = WorkflowState.EsrComparison,
                ExecutionDuration = evaluationDuration,
                Warnings = warnings,
                Errors = runErrors
            });

            await ExperimentRepository.SaveAsync(run);
            WorkflowState.ExperimentRunId = run.Metadata.RunId;
            statusMessage = $"Experiment run {run.Metadata.RunId} saved under dataset {run.Metadata.DatasetId}.";
        }
        catch (Exception exception)
        {
            errorMessage = $"The experiment could not be saved: {exception.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task<EvaluationRequest> BuildIndependentRequestAsync(CancellationToken cancellationToken = default)
    {
        if (string.IsNullOrWhiteSpace(callDocument.ExtractedText) ||
            string.IsNullOrWhiteSpace(proposalDocument.ExtractedText))
        {
            throw new InvalidOperationException("Call and Proposal text are required for independent evaluation.");
        }

        var profile = SelectedProfile;
        var promptContent = await PromptTemplateService.GetTemplateContentAsync(
            profile.PromptTemplateFileName!,
            cancellationToken);
        if (string.IsNullOrWhiteSpace(promptContent))
        {
            throw new InvalidOperationException($"The active prompt '{profile.PromptTemplateFileName}' is missing or empty.");
        }

        var request = new EvaluationRequest
        {
            CallDocument = callDocument,
            ProposalDocument = proposalDocument,
            Profile = profile,
            PromptTemplateName = profile.PromptTemplateFileName!,
            PromptTemplateContent = promptContent,
            InputFingerprint = ContentHashService.ComputeInputFingerprint(
                callDocument,
                proposalDocument,
                profile.Id,
                promptContent)
        };
        request.GeneratedPrompt = PromptBuilder.Build(request);
        return request;
    }

    private async Task<bool> EnsureEvaluationFingerprintIsCurrentAsync(CancellationToken cancellationToken = default)
    {
        if (WorkflowState.IndependentEvaluation is null)
        {
            errorMessage = "Run an independent evaluation first.";
            return false;
        }

        var currentPromptContent = await PromptTemplateService.GetTemplateContentAsync(
            SelectedProfile.PromptTemplateFileName!,
            cancellationToken);
        var currentFingerprint = ContentHashService.ComputeInputFingerprint(
            callDocument,
            proposalDocument,
            SelectedProfile.Id,
            currentPromptContent);

        if (!string.Equals(
            currentFingerprint,
            WorkflowState.IndependentEvaluation.InputFingerprint,
            StringComparison.Ordinal))
        {
            InvalidateIndependentState();
            errorMessage = "The Call, Proposal, profile, or prompt version changed. Run a new independent evaluation before comparing or saving.";
            return false;
        }

        activePromptContent = currentPromptContent;
        return true;
    }

    private ReferenceEvaluation CreateReferenceEvaluation() => new()
    {
        Criteria =
        [
            new ReferenceCriterionScore
            {
                CriterionId = EvaluationCriterionIds.Excellence,
                OfficialScore = officialExcellence!.Value
            },
            new ReferenceCriterionScore
            {
                CriterionId = EvaluationCriterionIds.Impact,
                OfficialScore = officialImpact!.Value
            },
            new ReferenceCriterionScore
            {
                CriterionId = EvaluationCriterionIds.Implementation,
                OfficialScore = officialImplementation!.Value
            }
        ]
    };

    private void ReferenceInputsChanged() => WorkflowState.InvalidateReferenceInputs();

    private void InvalidateForDocument(DocumentType documentType)
    {
        if (documentType == DocumentType.EvaluationSummaryReport)
        {
            WorkflowState.InvalidateReferenceInputs();
            return;
        }

        InvalidateIndependentState();
    }

    private void InvalidateIndependentState()
    {
        WorkflowState.InvalidateIndependentInputs();
        activePromptContent = null;
        evaluationDuration = TimeSpan.Zero;
    }

    private void CancelOperation() => operationCancellation?.Cancel();

    private int GetInputVersion(DocumentType documentType) => inputVersions[documentType];

    private ProcessedDocument GetDocument(DocumentType documentType) => documentType switch
    {
        DocumentType.CallDescription => callDocument,
        DocumentType.Proposal => proposalDocument,
        DocumentType.EvaluationSummaryReport => esrDocument,
        _ => throw new ArgumentOutOfRangeException(nameof(documentType), documentType, null)
    };

    private void SetDocument(DocumentType documentType, ProcessedDocument document)
    {
        switch (documentType)
        {
            case DocumentType.CallDescription:
                callDocument = document;
                break;
            case DocumentType.Proposal:
                proposalDocument = document;
                break;
            case DocumentType.EvaluationSummaryReport:
                esrDocument = document;
                break;
            default:
                throw new ArgumentOutOfRangeException(nameof(documentType), documentType, null);
        }
    }

    private void ClearMessages()
    {
        errorMessage = null;
        statusMessage = null;
    }

    private static ProcessedDocument NewDocument(DocumentType documentType) => new()
    {
        DocumentType = documentType
    };

    public void Dispose()
    {
        operationCancellation?.Cancel();
        operationCancellation?.Dispose();
    }
}
