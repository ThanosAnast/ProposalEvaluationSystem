@page "/experiment-history"
@rendermode InteractiveServer

@inject IExperimentRepository ExperimentRepository

<PageTitle>Experiment History</PageTitle>

<div class="workspace">
    <div class="page-heading">
        <div>
            <h1>Experiment History</h1>
            <p class="text-muted mb-0">Locally stored reproducibility metadata and evaluation outputs.</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-success" href="api/experiments/experiment-runs.csv">Export Runs CSV</a>
            <a class="btn btn-outline-success" href="api/experiments/criterion-comparisons.csv">Export Criteria CSV</a>
            <a class="btn btn-outline-primary" href="">Back to Evaluation</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert alert-success">@statusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    else if (isLoading)
    {
        <p>Loading experiment history…</p>
    }
    else if (summaries.Count == 0)
    {
        <div class="alert alert-info">No experiment runs have been saved yet.</div>
    }
    else
    {
        <div class="card section-card">
            <div class="card-body table-responsive">
                <table class="table table-sm align-middle history-table">
                    <thead>
                        <tr>
                            <th>Dataset ID</th>
                            <th>Run ID</th>
                            <th>Date (UTC)</th>
                            <th>Profile</th>
                            <th>Model</th>
                            <th class="text-end">LLM total</th>
                            <th class="text-end">ESR total</th>
                            <th class="text-end">Δ</th>
                            <th>LLM threshold</th>
                            <th>Agreement</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var summary in summaries)
                        {
                            <tr>
                                <td>@summary.DatasetId</td>
                                <td><code>@summary.RunId</code></td>
                                <td>@summary.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@summary.EvaluationProfileId</td>
                                <td>@summary.ModelName</td>
                                <td class="text-end">@summary.TotalScore.ToString("0.0")</td>
                                <td class="text-end">@(summary.OfficialTotalScore?.ToString("0.0") ?? "—")</td>
                                <td class="text-end">@(summary.TotalScoreDifference?.ToString("+0.0;-0.0;0.0") ?? "—")</td>
                                <td>@summary.ThresholdResult</td>
                                <td>
                                    @if (summary.ThresholdAgreement is bool agreement)
                                    {
                                        <span class="badge @(agreement ? "text-bg-success" : "text-bg-warning")">
                                            @(agreement ? "Agreement" : "Disagreement")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No ESR</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (IsDeletePending(summary))
                                    {
                                        <div class="d-flex align-items-center justify-content-end gap-1">
                                            <span class="text-danger fw-semibold me-1">Delete permanently?</span>
                                            <button class="btn btn-sm btn-danger"
                                                    type="button"
                                                    disabled="@(deletingRunId is not null)"
                                                    @onclick="@(() => DeleteExperimentAsync(summary))">
                                                @(IsDeleting(summary) ? "Deleting…" : "Confirm")
                                            </button>
                                            <button class="btn btn-sm btn-outline-secondary"
                                                    type="button"
                                                    disabled="@(deletingRunId is not null)"
                                                    @onclick="CancelDelete">Cancel</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex justify-content-end gap-1">
                                            <a class="btn btn-sm btn-outline-primary"
                                               href="@GetDetailsUrl(summary)">Details</a>
                                            <a class="btn btn-sm btn-outline-success"
                                               href="@GetDownloadUrl(summary)">JSON</a>
                                            <button class="btn btn-sm btn-outline-danger"
                                                    type="button"
                                                    disabled="@(deletingRunId is not null)"
                                                    aria-label="Delete experiment run @summary.RunId"
                                                    @onclick="@(() => RequestDelete(summary))">Delete</button>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private IReadOnlyList<ExperimentRunSummary> summaries = [];
    private bool isLoading = true;
    private string? errorMessage;
    private string? statusMessage;
    private string? pendingDeleteDatasetId;
    private string? pendingDeleteRunId;
    private string? deletingRunId;

    private static string GetDetailsUrl(ExperimentRunSummary summary) =>
        $"/experiment-history/{Uri.EscapeDataString(summary.DatasetId)}/{Uri.EscapeDataString(summary.RunId)}";

    private static string GetDownloadUrl(ExperimentRunSummary summary) =>
        $"/api/experiments/{Uri.EscapeDataString(summary.DatasetId)}/{Uri.EscapeDataString(summary.RunId)}/download";

    private bool IsDeletePending(ExperimentRunSummary summary) =>
        string.Equals(pendingDeleteDatasetId, summary.DatasetId, StringComparison.Ordinal) &&
        string.Equals(pendingDeleteRunId, summary.RunId, StringComparison.Ordinal);

    private bool IsDeleting(ExperimentRunSummary summary) =>
        string.Equals(deletingRunId, summary.RunId, StringComparison.Ordinal);

    private void RequestDelete(ExperimentRunSummary summary)
    {
        errorMessage = null;
        statusMessage = null;
        pendingDeleteDatasetId = summary.DatasetId;
        pendingDeleteRunId = summary.RunId;
    }

    private void CancelDelete()
    {
        pendingDeleteDatasetId = null;
        pendingDeleteRunId = null;
    }

    private async Task DeleteExperimentAsync(ExperimentRunSummary summary)
    {
        if (!IsDeletePending(summary) || deletingRunId is not null)
        {
            return;
        }

        errorMessage = null;
        statusMessage = null;
        deletingRunId = summary.RunId;

        try
        {
            var deleted = await ExperimentRepository.DeleteAsync(summary.DatasetId, summary.RunId);
            if (!deleted)
            {
                summaries = await ExperimentRepository.GetSummariesAsync();
                errorMessage = "The experiment run was not found. The history list has been refreshed.";
                return;
            }

            summaries = summaries
                .Where(item =>
                    !string.Equals(item.DatasetId, summary.DatasetId, StringComparison.Ordinal) ||
                    !string.Equals(item.RunId, summary.RunId, StringComparison.Ordinal))
                .ToArray();
            statusMessage = $"Experiment run {summary.RunId} was permanently deleted from dataset {summary.DatasetId}.";
        }
        catch (Exception exception)
        {
            errorMessage = $"The experiment run could not be deleted: {exception.Message}";
        }
        finally
        {
            deletingRunId = null;
            CancelDelete();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            summaries = await ExperimentRepository.GetSummariesAsync();
        }
        catch (Exception exception)
        {
            errorMessage = $"Experiment history could not be loaded: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
