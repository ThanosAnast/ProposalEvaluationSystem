@if (Result is not null)
{
    <section class="result-stack" id="evaluation-result">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-3">
            <div>
                <h2 class="h4 mb-1">Independent Evaluation</h2>
                <div class="text-muted small">@Result.PromptTemplateUsed · @Result.ProgrammeType · @Result.ModelName</div>
            </div>
            <span class="badge @(Result.ThresholdAssessment.Passed ? "text-bg-success" : "text-bg-warning") result-badge">
                @Result.ThresholdAssessment.OverallResult
            </span>
        </div>

        <div class="card result-card">
            <div class="card-body">
                <h3 class="h5">Executive Summary</h3>
                <p>@Result.ExecutiveSummary</p>

                <div class="table-responsive">
                    <table class="table table-sm align-middle score-table">
                        <thead>
                            <tr>
                                <th>Criterion</th>
                                <th class="text-end">Score</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var criterion in Result.Criteria)
                            {
                                <tr>
                                    <td>@criterion.Name</td>
                                    <td class="text-end">@criterion.Score.ToString("0.0")</td>
                                </tr>
                            }
                            <tr class="fw-semibold">
                                <td>Total score</td>
                                <td class="text-end">@Result.TotalScore.ToString("0.0") / @Result.ThresholdAssessment.MaximumTotalScore.ToString("0.0")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <p class="mb-0 text-muted">@Result.ThresholdAssessment.Explanation</p>
            </div>
        </div>

        @foreach (var criterion in Result.Criteria)
        {
            <CriterionEvaluationView Criterion="criterion" />
        }

        <div class="card result-card">
            <div class="card-body">
                <h3 class="h5">Final Comment</h3>
                <p>@Result.FinalComment</p>

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="metric-label">Confidence level</div>
                        <div class="fw-semibold">@Result.ConfidenceLevel</div>
                    </div>
                    <div class="col-md-8">
                        <div class="metric-label">Limitations</div>
                        <ul class="mb-0">
                            @foreach (var limitation in Result.Limitations)
                            {
                                <li>@limitation</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <details class="details-panel">
            <summary>Generated independent-evaluation prompt</summary>
            <pre class="prompt-output mt-3">@Result.GeneratedPrompt</pre>
        </details>
    </section>
}

@code {
    [Parameter, EditorRequired]
    public EvaluationResult? Result { get; set; }
}
