{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenAI": {
    "Model": "gpt-5.4-mini",
    "Endpoint": "https://api.openai.com/v1/responses",
    "MaxOutputTokens": 5000,
    "TimeoutSeconds": 180,
    "MaxAttempts": 3,
    "InitialRetryDelayMilliseconds": 500
  },
  "Experiments": {
    "StoreSensitiveContent": false
  },
  "AllowedHosts": "*"
}
